#Para hacer el análisis de amplicones se siguieron estos pasos:
#1.- Quitar los adaptadores con cutadapt
conda activate qiime2-amplicon-2025.7
mkdir results/01.cutadapt
out="results/01.cutadapt"
mkdir -p $out

for FILE in $(ls data/*.fastq | sed 's/\.fastq//' | sed 's/data\///' | sort -u); do
  cutadapt -m 800 -M 1800 \
    -g AGRGTTYGATYMTGGCTCAG -a RGYTACCTTGTTACGACTT -Z -j 4 \
    -o $out/"${FILE}_trimmed.fastq.gz" data/"${FILE}.fastq"
done
#el -m lo fui variando de 1200 hasta 800 y como las secuencias filtradas no vcambiaban para nada, decidí dejarlo en 800. Este me indica el largo mínimo que deben tener mis secuencias para ser consideradas. 
#el -M es para indicar el largo máximo que pueden tener
#-Z para hacerlos zip, -j el número de núcleos. es importante poner mkdir -p $out porque sin ese no se crean nuevos directorios y sale error
#Luego se debe crear el manifiesto:
# Crear archivo manifest
echo "sample-id,absolute-filepath,direction" > manifest.tsv
for FILE in results/01.cutadapt/*_trimmed.fastq.gz; do
  SAMPLE=$(basename $FILE _trimmed.fastq.gz)
  echo "$SAMPLE,$(readlink -f $FILE),forward" >> manifest.tsv
done
#importar a qiime2 
qiime tools import \
  --type 'SampleData[SequencesWithQuality]' \
  --input-path manifest.csv \
  --output-path demux-seqs.qza \
  --input-format SingleEndFastqManifestPhred33V2
#Visualizar la calidad de las secuencias
qiime demux summarize \
  --i-data demux-seqs.qza \
  --o-visualization demux-seqs.qzv
#el .qzv resultante puede ser visualizado en https://view.qiime2.org/visualization/
#en el help da la oción de denoise-ccs que sirve para pacbio pero no pude hacer que corra, así que utilicé single
qiime dada2 denoise-single \
  --i-demultiplexed-seqs demux-seqs.qza \
  --p-trunc-len 1469 \
  --p-max-ee 2 \
  --o-representative-sequences results/02.qiime/03.rep-seqs_v1.qza \
  --o-table results/02.qiime/03.feature-table_v1.qza \
  --o-denoising-stats results/02.qiime/03.denoising-stats_v1.qza \
  --p-n-threads 10
#descargué la base de datos de SILVA https://www.arb-silva.de/current-release/QIIME2/2025.7/SSU/full-length/uniform, la de SILVA138.2_SSURef_NR99_uniform_classifier_full-length.qza
#Lo descargué desde mi compu, así que me fui a Ubuntu para correr lo siguiente: 
scp -r SILVA138.2_SSURef_NR99_uniform_classifier_full-length.qza  dafranco@mitla.ccg.unam.mx:/data2/PEG/dafranco/Amplicones_16S
#Una vez copiado a donde lo necesitaba, lo pasé a data porque olvidé hacerlo antes
mv SILVA138.2_SSURef_NR99_uniform_classifier_full-length.qza data
#Luego corrí: 
qiime feature-classifier classify-sklearn  
--i-classifier data/SILVA138.2_SSURef_NR99_uniform_classifier_full-length.qza  
--i-reads results/02.qiime/03.rep-seqs_v1.qza   
--o-classification taxonomy.qza --p-n-jobs 10
#ahora para poder visualizar lo que ya tengo
# Visualizar la taxonomía
qiime metadata tabulate \
  --m-input-file results/02.qiime/taxonomy.qza \
  --o-visualization results/02.qiime/taxonomy.qzv
# Visualizar las secuencias representativas
qiime feature-table tabulate-seqs \
--i-data results/02.qiime/03.rep-seqs_v1.qza \
--o-visualization results/02.qiime/03.rep-seqs_v1.qza.qzv
# visualizar la tabla de conteos
qiime feature-table summarize \
--i-table results/02.qiime/03.feature-table_v1.qza \
--o-visualization results/02.qiime/03.feature-table_v1.qzv
